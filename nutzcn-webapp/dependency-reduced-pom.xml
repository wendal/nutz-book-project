<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>nutzcn-parent</artifactId>
    <groupId>net.wendal.nutzcn</groupId>
    <version>3.1.0</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>nutzcn-webapp</artifactId>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>2.10.3</version>
        <configuration>
          <additionalparam>-Xdoclint:none</additionalparam>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.nutz.boot</groupId>
        <artifactId>nutzboot-maven-plugin</artifactId>
        <version>${nutzboot.version}</version>
      </plugin>
      <plugin>
        <groupId>org.antlr</groupId>
        <artifactId>antlr4-maven-plugin</artifactId>
        <version>4.9</version>
        <executions>
          <execution>
            <goals>
              <goal>antlr4</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>yvr</id>
      <dependencies>
        <dependency>
          <groupId>net.wendal.nutzcn</groupId>
          <artifactId>nutzcn-yvr</artifactId>
          <version>3.1.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>beepay</id>
      <dependencies>
        <dependency>
          <groupId>net.wendal.nutzcn</groupId>
          <artifactId>nutzcn-beepay</artifactId>
          <version>3.1.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>shortit</id>
      <dependencies>
        <dependency>
          <groupId>net.wendal.nutzcn</groupId>
          <artifactId>nutzcn-shortit</artifactId>
          <version>3.1.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>dwmaster</id>
      <dependencies>
        <dependency>
          <groupId>net.wendal.nutzcn</groupId>
          <artifactId>nutzcn-dwmaster</artifactId>
          <version>3.1.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>sysinfo</id>
      <dependencies>
        <dependency>
          <groupId>net.wendal.nutzcn</groupId>
          <artifactId>nutzcn-sysinfo</artifactId>
          <version>${nutzcn.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>oauth</id>
      <dependencies>
        <dependency>
          <groupId>net.wendal.nutzcn</groupId>
          <artifactId>nutzcn-oauth</artifactId>
          <version>3.1.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>ngrok</id>
      <dependencies>
        <dependency>
          <groupId>net.wendal.nutzcn</groupId>
          <artifactId>nutzcn-ngrok</artifactId>
          <version>3.1.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>weixin</id>
      <dependencies>
        <dependency>
          <groupId>net.wendal.nutzcn</groupId>
          <artifactId>nutzcn-weixin</artifactId>
          <version>3.1.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>qqrobot</id>
      <dependencies>
        <dependency>
          <groupId>net.wendal.nutzcn</groupId>
          <artifactId>nutzcn-qqrobot</artifactId>
          <version>3.1.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>aliyuniot</id>
      <dependencies>
        <dependency>
          <groupId>net.wendal.nutzcn</groupId>
          <artifactId>nutzcn-aliyuniot</artifactId>
          <version>3.1.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>luat</id>
      <dependencies>
        <dependency>
          <groupId>net.wendal.nutzcn</groupId>
          <artifactId>nutzcn-luat</artifactId>
          <version>3.1.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
  <repositories>
    <repository>
      <id>nutz</id>
      <url>https://jfrog.nutz.cn/artifactory/libs-release</url>
    </repository>
    <repository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <updatePolicy>always</updatePolicy>
      </snapshots>
      <id>nutz-snapshots</id>
      <url>https://jfrog.nutz.cn/artifactory/snapshots</url>
    </repository>
  </repositories>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.nutz</groupId>
        <artifactId>nutzboot-parent</artifactId>
        <version>${nutzboot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <properties>
    <nutzcn.version>3.1.0</nutzcn.version>
    <nutzboot.version>2.4.0.v20200427</nutzboot.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
